{
  "expo": {
    "name": "Europa",
    "slug": "europa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/images/splash-screen-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#2E90FA"
    },
    "scheme": "europa",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.europa"
    },
    "android": {
      "package": "com.example.europa",
      "adaptiveIcon": {
        "backgroundColor": "#2E90FA",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2E90FA",
          "image": "./assets/images/splash-screen-logo.png",
          "imageWidth": 284,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4b6fa1a4-42f3-4e9c-b196-14d3078eb838"
      }
    },
    "owner": "gottaluvhenry"
  }
}
